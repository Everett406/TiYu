<?xml version="1.0" encoding="utf-8"?>
<!-- 学习统计卡（4×2，极简杂志风）：目标进度环 + 正确率 + 连续打卡 + 目标行
     v2.10.2 兼容性清零：进度环由 layer-list(rotate+ring) 矢量改为预渲染 PNG
     （ImageView+PNG 是 RemoteViews 最保守子集，规避 OEM 宿主 inflate 差异） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp">

            <ImageView
                android:id="@+id/wsRing"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/widget_ring_l_0"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/wsToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:textColor="#17171B" />

                <TextView
                    android:id="@+id/wsTodayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日"
                    android:textSize="9sp"
                    android:textColor="#8A8A85" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:id="@+id/wsHairV1"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#E9E9E4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/wsLabelM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正确率"
                android:textSize="10sp"
                android:textColor="#8A8A85" />

            <TextView
                android:id="@+id/wsAcc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0%"
                android:textSize="27sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#17171B" />

            <TextView
                android:id="@+id/wsAccSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="累计 0 题"
                android:textSize="10sp"
                android:textColor="#8A8A85" />
        </LinearLayout>

        <View
            android:id="@+id/wsHairV2"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#E9E9E4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/wsLabelR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连续打卡"
                android:textSize="10sp"
                android:textColor="#8A8A85" />

            <TextView
                android:id="@+id/wsStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 天"
                android:textSize="27sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#17171B" />

            <TextView
                android:id="@+id/wsGoalSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="答对 0 题"
                android:textSize="10sp"
                android:textColor="#8A8A85" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/wsFoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="10dp"
        android:text="距今日目标还差 30 题"
        android:textSize="11sp"
        android:maxLines="1"
        android:textColor="#8A8A85" />
</LinearLayout>
