<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v2.8.8：检查更新（查 GitHub Releases 最新版 + 浏览器打开发布页）；题库功能仍完全离线 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- v2.13.0：拍照搜题自建相机页（CameraX 取景框引导）需要运行时申请的 CAMERA 权限；
         无相机设备（部分平板/Chromebook）不因 uses-feature 被拒装 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- v2.15.0：每日提醒后台保活——调度引擎换 AlarmManager 精确闹钟（进程死也准时）：
         RECEIVE_BOOT_COMPLETED 开机/升级后重排；SCHEDULE_EXACT_ALARM 管 12/12L（默认授予），
         USE_EXACT_ALARM 管 13+（安装即授予，无需引导去系统设置）；
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 用于开启提醒时弹「后台运行」白名单请求 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".QuizApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroneQuiz">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v2.10.0：长按图标快捷方式（继续刷题/错题特训/随机小练/快速模考） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- v2.11.1：系统「其他应用打开」导入题库——微信/文件管理器里对题库 ZIP/CSV
                 点「从其他应用打开」即可直达导入流程。MIME 覆盖三类来源：
                 ① 标准 zip/csv 类型；② application/octet-stream（微信等对文件类型
                 推断不准确的兜底）；③ text/plain（csv 常被当作纯文本分享）。
                 格式真伪由 ExternalBankImporter 内容嗅探（PK 头）判定，不信任 MIME。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- v2.10.0：桌面小组件 ×4（RemoteViews 零新依赖） -->
        <receiver
            android:name="com.drone.quiz.util.ContinueWidgetProvider"
            android:exported="false"
            android:label="@string/short_continue">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_continue_info" />
        </receiver>
        <receiver
            android:name="com.drone.quiz.util.StatsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_stats">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_stats_info" />
        </receiver>
        <receiver
            android:name="com.drone.quiz.util.WrongWidgetProvider"
            android:exported="false"
            android:label="@string/short_wrong">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_wrong_info" />
        </receiver>
        <receiver
            android:name="com.drone.quiz.util.ExamWidgetProvider"
            android:exported="false"
            android:label="@string/short_exam">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_exam_info" />
        </receiver>

        <!-- v2.15.0：每日提醒闹钟触发 + 开机/覆盖安装重排。BOOT_COMPLETED 与
             MY_PACKAGE_REPLACED 均为受保护系统广播，仅系统可发，exported=true 无仿冒风险 -->
        <receiver
            android:name="com.drone.quiz.work.ReminderReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- v2.8.2：CSV 模板系统分享（只读授权 cache/share/ 临时文件） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
